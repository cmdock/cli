# cmdock-admin — local environment overrides.
#
# Copy to .env.local and fill in real values. The .env.local file is
# gitignored; only this .example template is committed. direnv + the
# justfile's `set dotenv-filename := ".env.local"` directive loads the
# overrides automatically when you cd into the repo.

# SSH targets for `just deploy-staging` / `just deploy-dogfood`
CMDOCK_CLI_STAGING_SSH=staging.example.com
CMDOCK_CLI_DOGFOOD_SSH=dogfood.example.com
